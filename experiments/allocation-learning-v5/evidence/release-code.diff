+    roster=read(root/'schedule.json');ordered={a:[cells[j['task_id'],a] for j in roster if j['arm']==a] for a in summary['arms']}
+    report={'plan_hash':plan['plan_hash'],'source_snapshot_hash':plan['source_snapshot_hash'],
